APP_NAME=ARTASWAHA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://artaswaha.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artaswaha
DB_USERNAME=artaswaha_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
FILESYSTEM_DISK=local

CACHE_STORE=redis
CACHE_PREFIX=artaswaha_prod_cache_
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=artaswaha_prod_database_
REDIS_QUEUE_RETRY_AFTER=300
DB_QUEUE_RETRY_AFTER=300

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=artaswaha-production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.artaswaha.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=artaswaha.example.com
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# Aktifkan setelah model analisis di server sudah diuji.
LEARNER_ANALYSIS_ENABLED=false
LEARNER_ANALYSIS_PROVIDER=ollama
LEARNER_ANALYSIS_URL=http://127.0.0.1:11434
LEARNER_ANALYSIS_MODEL=
LEARNER_ANALYSIS_KEY=

# Install runtime CLI memakai install-tts.sh, lalu isi path hasil installer.
TTS_ENABLED=false
TTS_ENGINE=chatterbox
TTS_DEVICE=cpu
TTS_CHATTERBOX_MODEL_PATH=
# Opsional: path absolut rekaman penutur Indonesia, WAV PCM 6-10 detik.
TTS_CHATTERBOX_REFERENCE_AUDIO=

# Opsional: adapter API lama. Tidak diperlukan untuk Chatterbox CLI.
TTS_API_URL=
TTS_API_KEY=
TTS_API_MODEL=
TTS_API_VOICE=

# Opsional: adapter lokal lama; runtime/bobot tidak ikut Git.
TTS_PYTHON=
TTS_MMS_MODEL_PATH=
TTS_ESPEAK_BINARY=
TTS_ESPEAK_DATA_PATH=

# Keduanya dibutuhkan untuk membuat draf kuis dari dokumen.
OCR_API_URL=
OCR_API_KEY=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Isi kredensial SMTP jika pengiriman email digunakan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Admin produksi dibuat dari akun terdaftar melalui app:make-admin-user.
# AdminUserSeeder sengaja tidak dijalankan pada environment production.
# Untuk membuat akun baru: isi ADMIN_* lalu jalankan ProductionAdminSeeder secara eksplisit.
ADMIN_NAME="Admin ARTASWAHA"
ADMIN_EMAIL=
ADMIN_PASSWORD=
